
name: Build Bahith PDF Pro Max

on:
  workflow_dispatch:
  push:
    branches:
      - main
    paths:
      - 'Bahith_PDF_Pro_Max_Advanced_Project.zip'
      - '.github/workflows/android.yml'

jobs:
  build:
    runs-on: ubuntu-latest

    steps:
      - name: Checkout repository
        uses: actions/checkout@v4

      - name: Check ZIP file
        run: |
          test -f Bahith_PDF_Pro_Max_Advanced_Project.zip

      - name: Setup Java
        uses: actions/setup-java@v4
        with:
          distribution: temurin
          java-version: '17'

      - name: Setup Android SDK
        uses: android-actions/setup-android@v3

      - name: Install Android SDK packages
        run: |
          sdkmanager "platforms;android-35" "build-tools;35.0.0"

      - name: Extract project ZIP
        run: |
          mkdir extracted
          unzip -q Bahith_PDF_Pro_Max_Advanced_Project.zip -d extracted
          cp -R extracted/Bahith_PDF_Pro_Max_Advanced/. .

      - name: Setup Gradle
        uses: gradle/actions/setup-gradle@v4
        with:
          gradle-version: '8.9'

      - name: Build APK
        run: |
          gradle :app:assembleDebug --no-daemon --stacktrace

      - name: Verify APK
        run: |
          test -f app/build/outputs/apk/debug/app-debug.apk

      - name: Upload APK
        uses: actions/upload-artifact@v4
        with:
          name: Bahith-PDF-Pro-Max-APK
          path: app/build/outputs/apk/debug/app-debug.apk
          
